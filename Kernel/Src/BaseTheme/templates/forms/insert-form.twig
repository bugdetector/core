{% extends "forms/form.twig" %}

{% block fields %}
	{% if form.isTranslatable() and getAvailableLanguageList()|length > 1 %}
		{% set translationIcons = getTranslationIcons() %}
		{% set defaultLang = defaultLanguage() %}
		<div class="card mb-6 bg-light border border-dashed border-gray-300 shadow-none">
			<div class="card-body py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
				<div class="d-flex align-items-center gap-2">
					<i class="fa fa-language fs-2 text-primary"></i>
					<div>
						<div class="fw-bolder fs-6 text-gray-800">{{ t('translation_language') }}</div>
						<div class="fs-7 text-muted">{{ t('translation_language_hint') }}</div>
					</div>
				</div>
				<div class="btn-group trans-lang-nav" role="group">
					{% for lang in getAvailableLanguageList() %}
						<button type="button" 
								class="btn btn-sm trans-lang-btn d-inline-flex align-items-center gap-2 {% if lang == defaultLang %}btn-primary active{% else %}btn-light-secondary text-gray-700{% endif %}" 
								data-lang="{{ lang }}">
							{% if translationIcons[lang] is defined and translationIcons[lang] %}
								<span class="d-inline-flex align-items-center trans-lang-icon">
									{{ translationIcons[lang]|raw }}
								</span>
							{% endif %}
							<span>{{ t(lang) }}</span>
						</button>
					{% endfor %}
				</div>
			</div>
		</div>
	{% endif %}

	{% set defaultLang = defaultLanguage() %}
	{% for field in form.fields %}
		{% set fieldLang = field.attributes['data-trans-lang']|default(null) %}
		<div class="mb-3 form-field {% if fieldLang %}trans-field-wrap{% endif %}" 
			 {% if fieldLang %}data-trans-lang-wrap="{{ fieldLang }}"{% if fieldLang != defaultLang %} style="display: none;"{% endif %}{% endif %}>
			{{ field }}
		</div>
	{% endfor %}
{% endblock %}
