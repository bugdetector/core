# CoreDB environment blueprint.
#
# This file is committed and contains working defaults for local docker development.
# Never put real secrets here. Override values in gitignored files instead:
#   .env.local            -> your machine (all environments)
#   .env.{APP_ENV}.local  -> a specific environment, e.g. .env.prod.local
# Real environment variables (docker compose, CI) override every file.
#
# Values containing "#", "$" or spaces must be quoted.

###> Application ###
# dev     -> Twig cache disabled, mails are sent to the test mail address.
# staging -> Twig cache enabled, mails are sent to the test mail address.
# prod    -> Twig cache enabled, mails are sent to real recipients.
APP_ENV=dev

TIMEZONE=Europe/Istanbul
LANGUAGE=tr
# Comma separated. The first one is used when the request host is not trusted.
TRUSTED_HOSTS=localhost
# Allowed CORS origin for the API.
FRONTEND_URL=http://localhost:3000
THEME='Src\BaseTheme\BaseTheme'
###< Application ###

###> Database ###
# "mysql" is the docker compose service name. Use host.docker.internal for MySQL on the host machine.
DB_DRIVER=mysql
DB_SERVER=mysql
DB_NAME=core
DB_USER=core
DB_PASSWORD=core
###< Database ###

###> Security ###
# Encrypts EncryptedModel fields and JWT tokens. Changing it makes existing encrypted data unreadable.
# This value is public: the application refuses to start with it when APP_ENV=prod.
# Generate a new one with: php -r 'echo bin2hex(random_bytes(32));'
HASH_SALT=f7011f3671a6a07a8a61523260e982215d25a4b884c42721009a71e55ae20062

# notify_all_users  -> Users can be logged in on one device only. Other sessions are closed.
# role_based_notify -> Same as above, only for the roles in LOGIN_POLICY_ROLES.
# not_notify        -> No restriction.
LOGIN_POLICY=not_notify
# Comma separated role names. Ex: Admin,User
LOGIN_POLICY_ROLES=
# Any strtotime() compatible duration.
REMEMBER_ME_TIMEOUT="1 week"

# Protects the whole site with HTTP basic auth (useful for staging).
HTTP_AUTH_ENABLED=false
HTTP_AUTH_USERNAME=
HTTP_AUTH_PASSWORD=
###< Security ###

###> PWA & push notifications ###
PWA_ENABLED=true
PWA_NAME="Core DB"
PWA_SHORT_NAME="C DB"
PWA_DESCRIPTION="Best practice web development tool."
PWA_THEME_COLOR="#fff"
PWA_BACKGROUND_COLOR="#fff"

NOTIFICATIONS_ENABLED=false
VAPID_SUBJECT=
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
# Relative to the project directory.
FIREBASE_CREDENTIALS_PATH=config/firebase-service-account.json
###< PWA & push notifications ###
